{% assign gold_purity = product.metafields.custom.gold_purity.value | default: "22K" %}
{% assign gold_weight = product.metafields.custom.gold_weight.value | default: 0 %}
{% assign craftsmanship = product.metafields.custom.craftsmanship.value | default: 0 %}
{% assign engraving_fee = product.metafields.custom.personal_engraving_fee.value | default: 0 %}
{% assign packaging_fee = product.metafields.custom.premium_packaging_fee.value | default: 0 %}

{% assign engraving_enabled = product.metafields.custom.personal_engraving.value %}
{% assign packaging_enabled = product.metafields.custom.premium_packaging.value %}

{% assign shop_currency = localization.country.currency.iso_code | default: shop.currency %}

<div
  class="gold-price-widget"
  data-gold-widget
  data-karat="{{ gold_purity | remove: 'K' | remove: 'k' }}"
  data-weight="{{ gold_weight }}"
  data-craftsmanship="{{ craftsmanship }}"
  data-engraving="{{ engraving_fee }}"
  data-packaging="{{ packaging_fee }}"
  data-currency="{{ shop_currency }}"
  data-engraving-enabled="{% if engraving_enabled %}true{% else %}false{% endif %}"
  data-packaging-enabled="{% if packaging_enabled %}true{% else %}false{% endif %}"
>
  <div class="gold-widget-header">
    <div>
      <div class="gold-widget-label">LIVE GOLD PRICE</div>

      <div class="gold-widget-title">
        {{ gold_purity }} Gold
      </div>
    </div>

    <div class="gold-widget-live">
      <span class="gold-live-dot"></span>
      <span data-updated-text>LIVE</span>
    </div>
  </div>

  <div class="gold-widget-price">
    <span data-gold-price>—</span>

    <span class="gold-widget-unit">
      <span data-currency-code>{{ shop_currency }}</span>
      / g
    </span>
  </div>

  <div class="gold-widget-details">

    <div class="gold-widget-row">
      <span>Gold Weight</span>

      <strong>
        {{ gold_weight }} g
      </strong>
    </div>

    <div class="gold-widget-row">
      <span>Gold Purity</span>

      <strong>
        {{ gold_purity }}
      </strong>
    </div>

    <div class="gold-widget-row">
      <span>Gold Value</span>

      <strong data-gold-value>—</strong>
    </div>

    <div class="gold-widget-row gold-widget-atelier-row">
      <div class="gold-widget-atelier-label">
        <span>Atelier Fee</span>

        <small>
          (The atelier fee includes the design development, craftsmanship and manufacturing, quality finishing, and signature packaging)
        </small>
      </div>

      <strong data-atelier-fee>—</strong>
    </div>

    <div class="gold-widget-row gold-widget-final-total">
      <span>Total Price</span>

      <strong data-final-product-price>—</strong>
    </div>

  </div>

  <div class="gold-widget-footer">
    <span class="gold-footer-dot"></span>

    <span data-footer-status>
      Latest saved gold price
    </span>
  </div>
</div>


<style>

.gold-price-widget {
  width: 100%;
  max-width: 520px;
  box-sizing: border-box;

  padding: 24px;
  margin: 20px 0;

  border: 1px solid #e8e8e8;
  border-radius: 16px;

  background: #ffffff;
  color: #171717;

  font-family: inherit;

  box-shadow:
    0 8px 28px rgba(0, 0, 0, 0.05);
}


.gold-widget-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;
}


.gold-widget-label {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1.8px;

  color: #8a8a8a;

  margin-bottom: 7px;
}


.gold-widget-title {
  font-size: 24px;
  line-height: 1.2;

  font-weight: 650;

  color: #171717;
}


.gold-widget-live {
  display: flex;
  align-items: center;

  gap: 7px;

  padding: 7px 11px;

  border-radius: 20px;

  background: #f3f8f3;
  color: #527157;

  font-size: 12px;

  white-space: nowrap;
}


.gold-live-dot {
  width: 8px;
  height: 8px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #5b8a5e;

  box-shadow:
    0 0 0 3px rgba(91, 138, 94, 0.12);
}


.gold-widget-price {
  display: flex;
  align-items: baseline;

  gap: 8px;

  margin: 32px 0 25px;
}


.gold-widget-price [data-gold-price] {
  font-size: 32px;
  line-height: 1;

  font-weight: 700;

  letter-spacing: -0.8px;

  color: #171717;
}


.gold-widget-unit {
  font-size: 14px;
  color: #888;
}


.gold-widget-details {
  border-top: 1px solid #eeeeee;
}


.gold-widget-row {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 14px 0;

  border-bottom: 1px solid #eeeeee;

  font-size: 15px;
}


.gold-widget-row > span {
  color: #666;
}


.gold-widget-row strong {
  color: #171717;

  font-weight: 600;

  text-align: right;

  white-space: nowrap;
}


/* Atelier Fee */

.gold-widget-atelier-label {
  display: flex;
  flex-direction: column;

  gap: 5px;

  min-width: 0;
}


.gold-widget-atelier-label > span {
  color: #666;
}


.gold-widget-atelier-label small {
  max-width: 330px;

  color: #999;

  font-size: 10px;
  line-height: 1.4;

  font-weight: 400;
}


.gold-widget-final-total {
  padding-top: 18px;
  padding-bottom: 4px;

  border-bottom: none;
}


.gold-widget-final-total > span {
  color: #222;

  font-weight: 700;
}


.gold-widget-final-total strong {
  font-size: 19px;

  font-weight: 700;
}


.gold-widget-footer {
  display: flex;

  align-items: center;

  gap: 7px;

  margin-top: 16px;

  font-size: 11px;

  color: #999;
}


.gold-footer-dot {
  width: 5px;
  height: 5px;

  flex-shrink: 0;

  border-radius: 50%;

  background: #5b8a5e;
}


@media screen and (max-width: 749px) {

  .gold-price-widget {
    padding: 18px;

    margin: 15px 0;

    border-radius: 14px;
  }


  .gold-widget-title {
    font-size: 21px;
  }


  .gold-widget-price {
    margin-top: 28px;
  }


  .gold-widget-price [data-gold-price] {
    font-size: 28px;
  }


  .gold-widget-row {
    padding: 13px 0;

    font-size: 14px;
  }


  .gold-widget-live {
    font-size: 11px;

    padding: 6px 9px;
  }


  .gold-widget-atelier-label small {
    max-width: 220px;

    font-size: 9px;
  }

}

</style>


<script>

(function () {

  /*
   * Get the storefront currency.
   */

  function getActiveCurrency(widget) {

    let currency = "";

    if (
      window.Shopify &&
      window.Shopify.currency
    ) {
      currency =
        window.Shopify.currency.active ||
        window.Shopify.currency.currency ||
        "";
    }

    if (!currency) {
      currency =
        widget.dataset.currency || "";
    }

    return String(currency || "USD")
      .trim()
      .toUpperCase();
  }


  /*
   * Format money according to storefront currency.
   */

  function formatPrice(value, currency) {

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return "—";
    }

    try {

      return new Intl.NumberFormat(
        undefined,
        {
          style: "currency",
          currency: currency,

          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(number);

    } catch (error) {

      return (
        currency +
        " " +
        number.toLocaleString(
          undefined,
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        )
      );
    }
  }


  function initGoldWidget(widget) {

    if (!widget) {
      return;
    }


    /*
     * Prevent duplicate initialization.
     */

    if (
      widget.dataset.initialized === "true"
    ) {
      return;
    }

    widget.dataset.initialized = "true";


    const priceEl =
      widget.querySelector(
        "[data-gold-price]"
      );


    const goldValueEl =
      widget.querySelector(
        "[data-gold-value]"
      );


    const atelierFeeEl =
      widget.querySelector(
        "[data-atelier-fee]"
      );


    const finalProductPriceEl =
      widget.querySelector(
        "[data-final-product-price]"
      );


    const updatedEl =
      widget.querySelector(
        "[data-updated-text]"
      );


    const footerEl =
      widget.querySelector(
        "[data-footer-status]"
      );


    const currencyCodeEl =
      widget.querySelector(
        "[data-currency-code]"
      );


    const karat =
      Number(widget.dataset.karat) || 22;


    const weight =
      Number(widget.dataset.weight) || 0;


    const craftsmanshipPercent =
      Number(widget.dataset.craftsmanship) || 0;


    const engravingPercent =
      Number(widget.dataset.engraving) || 0;


    const packagingPercent =
      Number(widget.dataset.packaging) || 0;


    const engravingEnabled =
      widget.dataset.engravingEnabled === "true";


    const packagingEnabled =
      widget.dataset.packagingEnabled === "true";


    /*
     * Current storefront currency.
     */

    const currency =
      getActiveCurrency(widget);


    if (currencyCodeEl) {

      currencyCodeEl.textContent =
        currency;

    }


    /*
     * IMPORTANT
     *
     * This request goes to our Shopify app endpoint.
     *
     * It DOES NOT call GoldAPI.
     *
     * /apps/gold-price reads the latest saved
     * gold price from the database.
     *
     * GoldAPI is only called by the
     * Update All Products flow.
     */

    const apiUrl =
      "/apps/gold-price?currency=" +
      encodeURIComponent(currency);


    fetch(
      apiUrl,
      {
        method: "GET",

        headers: {
          "Accept": "application/json"
        },

        cache: "no-store"
      }
    )

    .then(function (response) {

      if (!response.ok) {

        throw new Error(
          "Gold price request failed: " +
          response.status
        );
      }

      return response.json();

    })


    .then(function (data) {

      if (
        !data ||
        !data.success ||
        !data.prices
      ) {

        throw new Error(
          "Invalid saved gold price response"
        );
      }


      const apiCurrency =
        String(
          data.currency ||
          currency
        )
        .toUpperCase();


      if (currencyCodeEl) {

        currencyCodeEl.textContent =
          apiCurrency;

      }


      /*
       * Example:
       *
       * 18K -> 18k
       * 22K -> 22k
       * 24K -> 24k
       */

      const priceKey =
        String(karat) + "k";


      const pricePerGram =
        Number(
          data.prices[priceKey]
        );


      if (
        !Number.isFinite(pricePerGram) ||
        pricePerGram <= 0
      ) {

        throw new Error(
          "Gold price unavailable"
        );
      }


      /*
       * GOLD VALUE
       *
       * Gold price per gram
       * × product gold weight.
       */

      const goldValue =
        pricePerGram * weight;


      /*
       * ACTIVE FEES
       *
       * Craftsmanship is always included
       * when greater than zero.
       *
       * Engraving is included only when enabled.
       *
       * Packaging is included only when enabled.
       */

      let totalFeePercent = 0;


      if (
        craftsmanshipPercent > 0
      ) {

        totalFeePercent +=
          craftsmanshipPercent;
      }


      if (
        engravingEnabled &&
        engravingPercent > 0
      ) {

        totalFeePercent +=
          engravingPercent;
      }


      if (
        packagingEnabled &&
        packagingPercent > 0
      ) {

        totalFeePercent +=
          packagingPercent;
      }


      /*
       * Gold represents the remaining
       * percentage of the final price.
       *
       * Example:
       *
       * Craftsmanship = 20%
       * Engraving = 5%
       * Packaging = 3%
       *
       * Total fees = 28%
       *
       * Gold portion = 72%
       */

      const goldPortionPercent =
        100 - totalFeePercent;


      if (
        goldPortionPercent <= 0
      ) {

        throw new Error(
          "Invalid fee percentages. Total fee percentage must be less than 100%."
        );
      }


      /*
       * FINAL PRODUCT PRICE
       *
       * Gold Value is the remaining
       * percentage of the final price.
       *
       * Example:
       *
       * Gold Value = 720
       * Gold portion = 72%
       *
       * Total Price = 720 / 0.72
       *
       * = 1000
       */

      const finalProductPrice =
        goldValue /
        (goldPortionPercent / 100);


      /*
       * INDIVIDUAL FEES
       *
       * These are calculated from
       * the final product price.
       */

      const craftsmanshipValue =
        finalProductPrice *
        craftsmanshipPercent /
        100;


      const engravingValue =
        engravingEnabled
          ? finalProductPrice *
            engravingPercent /
            100
          : 0;


      const packagingValue =
        packagingEnabled
          ? finalProductPrice *
            packagingPercent /
            100
          : 0;


      /*
       * ATELIER FEE
       *
       * Atelier Fee =
       *
       * Craftsmanship
       * + Personal Engraving
       * + Premium Packaging
       */

      const atelierFee =
        craftsmanshipValue +
        engravingValue +
        packagingValue;


      /*
       * LIVE GOLD PRICE
       */

      if (priceEl) {

        priceEl.textContent =
          formatPrice(
            pricePerGram,
            apiCurrency
          );
      }


      /*
       * GOLD VALUE
       */

      if (goldValueEl) {

        goldValueEl.textContent =
          formatPrice(
            goldValue,
            apiCurrency
          );
      }


      /*
       * ATELIER FEE
       */

      if (atelierFeeEl) {

        atelierFeeEl.textContent =
          formatPrice(
            atelierFee,
            apiCurrency
          );
      }


      /*
       * TOTAL PRICE
       */

      if (finalProductPriceEl) {

        finalProductPriceEl.textContent =
          formatPrice(
            finalProductPrice,
            apiCurrency
          );
      }


      /*
       * LIVE STATUS
       *
       * The widget intentionally shows
       * LIVE instead of the saved
       * database timestamp.
       */

      if (updatedEl) {

        updatedEl.textContent =
          "LIVE";

      }


      /*
       * Footer status.
       */

      if (footerEl) {

        footerEl.textContent =
          "Latest saved gold price";
      }

    })


    .catch(function (error) {

      console.error(
        "Gold widget error:",
        error
      );


      if (priceEl) {
        priceEl.textContent = "—";
      }


      if (goldValueEl) {
        goldValueEl.textContent = "—";
      }


      if (atelierFeeEl) {
        atelierFeeEl.textContent = "—";
      }


      if (finalProductPriceEl) {
        finalProductPriceEl.textContent = "—";
      }


      if (updatedEl) {
        updatedEl.textContent =
          "Price unavailable";
      }


      if (footerEl) {
        footerEl.textContent =
          "Gold price temporarily unavailable";
      }

    });

  }


  function initAllWidgets() {

    const widgets =
      document.querySelectorAll(
        "[data-gold-widget]"
      );


    widgets.forEach(
      function (widget) {

        initGoldWidget(widget);

      }
    );

  }


  /*
   * Initial load.
   */

  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initAllWidgets
    );

  } else {

    initAllWidgets();

  }


  /*
   * Shopify Theme Editor support.
   */

  document.addEventListener(
    "shopify:section:load",
    function () {

      initAllWidgets();

    }
  );


})();

</script>


{% schema %}
{
  "name": "Live Gold Price",
  "target": "section",
  "settings": []
}
{% endschema %}