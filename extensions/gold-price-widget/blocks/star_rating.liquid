<div
  class="gold-price-widget"
  data-gold-widget
  data-product-id="{{ product.id }}"
>
  <div class="gold-widget-header">
    <div>
      <div class="gold-widget-title">Live Gold Price</div>
      <div class="gold-widget-subtitle" data-karat-label>
        {{ product.metafields.custom.gold_purity.value | default: "22K" }} Gold
      </div>
    </div>

    <div class="gold-widget-live">
      <span class="gold-live-dot"></span>
      <span data-updated-text>Updated just now</span>
    </div>
  </div>

  <div class="gold-widget-price">
    <span data-gold-price>Loading...</span>
    <span>/ g</span>
  </div>

  <div class="gold-widget-row">
    <span>Weight</span>
    <strong>{{ product.metafields.custom.gold_weight.value | default: 0 }} g</strong>
  </div>

  <div class="gold-widget-row">
    <span>Karat</span>
    <strong data-karat-value>
      {{ product.metafields.custom.gold_purity.value | default: "22K" }}
    </strong>
  </div>

  <div class="gold-widget-row">
    <span>Gold Value</span>
    <strong data-gold-value>Calculating...</strong>
  </div>

  {% assign craftsmanship = product.metafields.custom.craftsmanship.value | default: 0 %}
  {% assign engraving_fee = product.metafields.custom.personal_engraving_fee.value | default: 0 %}
  {% assign packaging_fee = product.metafields.custom.premium_packaging_fee.value | default: 0 %}

  <div class="gold-widget-row">
    <span>Craftsmanship</span>
    <strong>
      {{ craftsmanship }}%
      <small data-craftsmanship-value></small>
    </strong>
  </div>

  {% if product.metafields.custom.personal_engraving.value %}
    <div class="gold-widget-row">
      <span>Engraving</span>
      <strong>
        {{ engraving_fee }}%
        <small data-engraving-value></small>
      </strong>
    </div>
  {% endif %}

  {% if product.metafields.custom.premium_packaging.value %}
    <div class="gold-widget-row">
      <span>Premium Packaging</span>
      <strong>
        {{ packaging_fee }}%
        <small data-packaging-value></small>
      </strong>
    </div>
  {% endif %}
</div>

<script>
(() => {
  const widget = document.querySelector("[data-gold-widget]");
  if (!widget) return;

  const goldPriceEl = widget.querySelector("[data-gold-price]");
  const goldValueEl = widget.querySelector("[data-gold-value]");
  const craftsmanshipValueEl = widget.querySelector("[data-craftsmanship-value]");
  const engravingValueEl = widget.querySelector("[data-engraving-value]");
  const packagingValueEl = widget.querySelector("[data-packaging-value]");
  const updatedEl = widget.querySelector("[data-updated-text]");

  const weight = Number({{ product.metafields.custom.gold_weight.value | default: 0 | json }});
  const karatText = {{ product.metafields.custom.gold_purity.value | default: "22K" | json }};

  const craftsmanshipPercent =
    Number({{ product.metafields.custom.craftsmanship.value | default: 0 | json }});

  const engravingPercent =
    Number({{ product.metafields.custom.personal_engraving_fee.value | default: 0 | json }});

  const packagingPercent =
    Number({{ product.metafields.custom.premium_packaging_fee.value | default: 0 | json }});

  const engravingEnabled =
    {{ product.metafields.custom.personal_engraving.value | default: false | json }};

  const packagingEnabled =
    {{ product.metafields.custom.premium_packaging.value | default: false | json }};

  function getKarat() {
    const match = String(karatText).match(/\d+/);
    return match ? Number(match[0]) : 22;
  }

  function formatPrice(value) {
    return new Intl.NumberFormat("en-PK", {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(value);
  }

  async function loadGoldPrice() {
    try {
      const response = await fetch("/apps/gold-price-updater/api/gold-price");

      if (!response.ok) {
        throw new Error("Gold price request failed");
      }

      const data = await response.json();

      if (!data.success) {
        throw new Error(data.error || "Unable to load gold price");
      }

      const karat = getKarat();
      const pricePerGram = Number(data.prices[String(karat) + "k"]);

      if (!pricePerGram) {
        throw new Error("Price for selected karat was not found");
      }

      const goldValue = pricePerGram * weight;

      const craftsmanshipValue =
        goldValue * craftsmanshipPercent / 100;

      const engravingValue =
        engravingEnabled
          ? goldValue * engravingPercent / 100
          : 0;

      const packagingValue =
        packagingEnabled
          ? goldValue * packagingPercent / 100
          : 0;

      goldPriceEl.textContent = "Rs. " + formatPrice(pricePerGram);
      goldValueEl.textContent = "Rs. " + formatPrice(goldValue);

      if (craftsmanshipValueEl) {
        craftsmanshipValueEl.textContent =
          "Rs. " + formatPrice(craftsmanshipValue);
      }

      if (engravingValueEl) {
        engravingValueEl.textContent =
          "Rs. " + formatPrice(engravingValue);
      }

      if (packagingValueEl) {
        packagingValueEl.textContent =
          "Rs. " + formatPrice(packagingValue);
      }

      if (data.updatedAt) {
        const updated = new Date(data.updatedAt);
        updatedEl.textContent =
          "Updated " + updated.toLocaleTimeString([], {
            hour: "2-digit",
            minute: "2-digit"
          });
      }

    } catch (error) {
      console.error("Gold widget error:", error);
      goldPriceEl.textContent = "Unavailable";
      goldValueEl.textContent = "Unable to calculate";
    }
  }

  loadGoldPrice();
})();
</script>

<style>
.gold-price-widget {
  border: 1px solid #e5e5e5;
  border-radius: 12px;
  padding: 18px;
  margin: 20px 0;
  background: #fff;
  font-family: inherit;
}

.gold-widget-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
}

.gold-widget-title {
  font-size: 18px;
  font-weight: 600;
}

.gold-widget-subtitle {
  margin-top: 4px;
  font-size: 14px;
  color: #666;
}

.gold-widget-live {
  font-size: 11px;
  color: #777;
  white-space: nowrap;
}

.gold-live-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #22a06b;
  margin-right: 4px;
}

.gold-widget-price {
  margin: 18px 0;
  font-size: 24px;
  font-weight: 700;
}

.gold-widget-price span:last-child {
  font-size: 13px;
  font-weight: 400;
  color: #777;
}

.gold-widget-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding: 9px 0;
  border-top: 1px solid #f0f0f0;
  font-size: 14px;
}

.gold-widget-row strong {
  text-align: right;
}

.gold-widget-row small {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: #777;
  font-weight: 400;
}
</style>

{% schema %}
{
  "name": "Live Gold Price",
  "target": "section",
  "settings": []
}
{% endschema %}