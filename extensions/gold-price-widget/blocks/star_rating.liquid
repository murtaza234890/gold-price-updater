{% assign gold_purity = product.metafields.custom.gold_purity.value | default: "22K" %}
{% assign gold_weight = product.metafields.custom.gold_weight.value | default: 0 %}
{% assign craftsmanship = product.metafields.custom.craftsmanship.value | default: 0 %}
{% assign engraving_fee = product.metafields.custom.personal_engraving_fee.value | default: 0 %}
{% assign packaging_fee = product.metafields.custom.premium_packaging_fee.value | default: 0 %}

{% assign engraving_enabled = product.metafields.custom.personal_engraving.value %}
{% assign packaging_enabled = product.metafields.custom.premium_packaging.value %}

{% assign shop_currency = localization.country.currency.iso_code | default: shop.currency %}

<div
  class="gold-price-widget"
  data-gold-widget
  data-karat="{{ gold_purity | remove: 'K' | remove: 'k' }}"
  data-weight="{{ gold_weight }}"
  data-craftsmanship="{{ craftsmanship }}"
  data-engraving="{{ engraving_fee }}"
  data-packaging="{{ packaging_fee }}"
  data-currency="{{ shop_currency }}"
  data-engraving-enabled="{% if engraving_enabled %}true{% else %}false{% endif %}"
  data-packaging-enabled="{% if packaging_enabled %}true{% else %}false{% endif %}"
>

  <script type="application/json" data-variant-gold-map>
    [
      {% for variant in product.variants %}
        {% assign var_craftsmanship = variant.metafields.custom.craftsmanship.value | default: craftsmanship %}
        {% assign var_engraving_fee = variant.metafields.custom.personal_engraving_fee.value | default: engraving_fee %}
        {% assign var_packaging_fee = variant.metafields.custom.premium_packaging_fee.value | default: packaging_fee %}

        {% assign var_engraving_enabled = variant.metafields.custom.personal_engraving.value %}
        {% if var_engraving_enabled == nil %}
          {% assign var_engraving_enabled = engraving_enabled %}
        {% endif %}

        {% assign var_packaging_enabled = variant.metafields.custom.premium_packaging.value %}
        {% if var_packaging_enabled == nil %}
          {% assign var_packaging_enabled = packaging_enabled %}
        {% endif %}

        {
          "id": {{ variant.id | json }},
          "title": {{ variant.title | json }},
          "weight": {{ variant.metafields.custom.gold_weight.value | default: gold_weight | json }},
          "karat": {{ variant.metafields.custom.gold_purity.value | default: gold_purity | remove: 'K' | remove: 'k' | json }},
          "craftsmanship": {{ var_craftsmanship | json }},
          "engravingFee": {{ var_engraving_fee | json }},
          "packagingFee": {{ var_packaging_fee | json }},
          "engravingEnabled": {% if var_engraving_enabled %}true{% else %}false{% endif %},
          "packagingEnabled": {% if var_packaging_enabled %}true{% else %}false{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>


  <!-- GOLD DETAILS -->

  <div class="marami-gold-details">

    <div class="marami-header">
      <div class="marami-heading">
        GOLD DETAILS
      </div>

      <div class="marami-latest-price">
        Latest gold price
      </div>
    </div>


    <!-- GOLD PRICE -->

    <div class="marami-row">
      <span>Gold Price / g</span>
      <strong data-gold-price>—</strong>
    </div>


    <!-- GOLD WEIGHT -->

    <div class="marami-row">
      <div class="marami-row-label">
        <span>Gold Weight</span>
        <small>(approximately)</small>
      </div>

      <strong data-weight-display>
        {% if gold_weight != blank %}
          {{ gold_weight | times: 1.0 | round: 1 }} g
        {% else %}
          0.0 g
        {% endif %}
      </strong>
    </div>


    <!-- GOLD PURITY -->

    <div class="marami-row">
      <span>Gold Purity</span>
      <strong data-purity-display>
        {{ gold_purity | downcase }}
      </strong>
    </div>


    <!-- GOLD VALUE -->

    <div class="marami-row">
      <span>Gold Value</span>
      <strong data-gold-value>—</strong>
    </div>

  </div>


  <!-- ATELIER FEE -->

  <div class="marami-atelier">

    <div class="marami-atelier-content">

      <div class="marami-atelier-title">
        MARAMI ATELIER FEE
      </div>

      <div class="marami-atelier-description">
        Includes design development, craftsmanship, manufacturing, quality finishing and signature packaging.
      </div>

    </div>

    <strong
      class="marami-atelier-price"
      data-atelier-fee
    >
      —
    </strong>

  </div>


  <!-- TOTAL PRICE -->

  <div class="marami-total">

    <span class="marami-total-label">
      TOTAL PRICE
    </span>

    <strong
      class="marami-total-price"
      data-final-product-price
    >
      —
    </strong>

  </div>


  <!-- FOOTER -->

  <div class="marami-footer">
    <span data-footer-status>
      Latest saved gold price
    </span>
  </div>

</div>


<style>

.gold-price-widget {
  width: 100%;
  max-width: 560px;
  margin: 24px 0;
  color: #24201c;
  font-family: Arial, Helvetica, sans-serif;
  -webkit-font-smoothing: antialiased;
}

.gold-price-widget *,
.gold-price-widget *::before,
.gold-price-widget *::after {
  box-sizing: border-box;
}


/* =========================================
   GOLD DETAILS
========================================= */

.marami-gold-details {
  width: 100%;
}

.marami-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding-bottom: 14px;
  border-bottom: 1px solid #d9d9d9;
}

.marami-heading {
  font-size: 16px;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 0.12em;
  color: #252525;
}

.marami-latest-price {
  font-size: 11px;
  color: #777;
  white-space: nowrap;
}


/* =========================================
   DETAIL ROWS
========================================= */

.marami-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  min-height: 62px;
  padding: 14px 0;
  border-bottom: 1px solid #e1e1e1;
}

.marami-row > span,
.marami-row-label > span {
  font-size: 14px;
  line-height: 1.3;
  color: #333;
  font-weight: 500;
}

.marami-row strong {
  font-size: 15px;
  line-height: 1.3;
  color: #222;
  font-weight: 600;
  text-align: right;
  white-space: nowrap;
}

.marami-row-label {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.marami-row-label small {
  font-size: 10px;
  line-height: 1.2;
  color: #888;
}


/* =========================================
   ATELIER FEE
========================================= */

.marami-atelier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 20px 0;
  border-bottom: 1px solid #bcbcbc;
}

.marami-atelier-content {
  min-width: 0;
  flex: 1;
}

.marami-atelier-title {
  margin-bottom: 5px;
  font-size: 14px;
  line-height: 1.25;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #222;
}

.marami-atelier-description {
  max-width: 350px;
  font-size: 10px;
  line-height: 1.45;
  color: #777;
}

.marami-atelier-price {
  flex-shrink: 0;
  font-size: 15px;
  line-height: 1.3;
  font-weight: 600;
  color: #222;
  white-space: nowrap;
  text-align: right;
}


/* =========================================
   TOTAL PRICE
========================================= */

.marami-total {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 0 16px;
}

.marami-total-label {
  font-size: 16px;
  line-height: 1.2;
  font-weight: 600;
  letter-spacing: 0.1em;
  color: #222;
  white-space: nowrap;
}

.marami-total-price {
  font-size: 25px;
  line-height: 1.1;
  font-weight: 500;
  color: #222;
  white-space: nowrap;
  text-align: right;
}


/* =========================================
   FOOTER
========================================= */

.marami-footer {
  padding-top: 8px;
  font-size: 9.5px;
  line-height: 1.3;
  color: #888;
}


/* =========================================
   MOBILE
========================================= */

@media screen and (max-width: 640px) {

  .gold-price-widget {
    margin: 18px 0;
  }

  .marami-heading {
    font-size: 14px;
  }

  .marami-latest-price {
    font-size: 10px;
  }

  .marami-row {
    min-height: 58px;
    padding: 13px 0;
  }

  .marami-row > span,
  .marami-row-label > span {
    font-size: 13px;
  }

  .marami-row strong {
    font-size: 14px;
  }

  .marami-atelier {
    padding: 17px 0;
  }

  .marami-atelier-title {
    font-size: 13px;
  }

  .marami-atelier-description {
    font-size: 9.5px;
  }

  .marami-atelier-price {
    font-size: 14px;
  }

  .marami-total {
    padding: 17px 0 14px;
  }

  .marami-total-label {
    font-size: 14px;
  }

  .marami-total-price {
    font-size: 21px;
  }
}


@media screen and (max-width: 440px) {

  .marami-header {
    padding-bottom: 11px;
  }

  .marami-heading {
    font-size: 13px;
    letter-spacing: 0.09em;
  }

  .marami-latest-price {
    font-size: 9px;
  }

  .marami-row {
    min-height: 54px;
    padding: 11px 0;
  }

  .marami-row > span,
  .marami-row-label > span {
    font-size: 12px;
  }

  .marami-row strong {
    font-size: 13px;
  }

  .marami-row-label small {
    font-size: 9px;
  }

  .marami-atelier {
    gap: 12px;
  }

  .marami-atelier-title {
    font-size: 11.5px;
    letter-spacing: 0.07em;
  }

  .marami-atelier-description {
    font-size: 8.5px;
    line-height: 1.4;
  }

  .marami-atelier-price {
    font-size: 12.5px;
  }

  .marami-total-label {
    font-size: 12px;
    letter-spacing: 0.07em;
  }

  .marami-total-price {
    font-size: 18px;
  }

  .marami-footer {
    font-size: 8.5px;
  }
}

</style>


<script>

(function () {

  /* ======================================================
     GET ACTIVE CURRENCY
  ====================================================== */

  function getActiveCurrency(widget) {

    let currency = "";

    if (
      window.Shopify &&
      window.Shopify.currency
    ) {
      currency =
        window.Shopify.currency.active ||
        window.Shopify.currency.currency ||
        "";
    }

    if (!currency) {
      currency =
        widget.dataset.currency || "";
    }

    return String(currency || "USD")
      .trim()
      .toUpperCase();
  }


  /* ======================================================
     FORMAT MONEY
  ====================================================== */

  function formatPrice(value, currency) {

    const number = Number(value);

    if (!Number.isFinite(number)) {
      return "—";
    }

    return (
      currency +
      " " +
      number.toLocaleString("en-US", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      })
    );
  }


  /* ======================================================
     INITIALIZE
  ====================================================== */

  function initGoldWidget(widget) {

    if (!widget) {
      return;
    }

    if (
      widget.dataset.initialized === "true"
    ) {
      return;
    }

    widget.dataset.initialized = "true";


    /* ELEMENTS */

    const priceEl =
      widget.querySelector(
        "[data-gold-price]"
      );

    const goldValueEl =
      widget.querySelector(
        "[data-gold-value]"
      );

    const atelierFeeEl =
      widget.querySelector(
        "[data-atelier-fee]"
      );

    const finalProductPriceEl =
      widget.querySelector(
        "[data-final-product-price]"
      );

    const footerEl =
      widget.querySelector(
        "[data-footer-status]"
      );


    /* PRODUCT DATA */

    const karat =
      Number(widget.dataset.karat) || 22;

    const weight =
      Number(widget.dataset.weight) || 0;

    const craftsmanshipPercent =
      Number(widget.dataset.craftsmanship) || 0;

    const engravingPercent =
      Number(widget.dataset.engraving) || 0;

    const packagingPercent =
      Number(widget.dataset.packaging) || 0;

    const engravingEnabled =
      widget.dataset.engravingEnabled === "true";

    const packagingEnabled =
      widget.dataset.packagingEnabled === "true";


    /* CURRENCY */

    const currency =
      getActiveCurrency(widget);


    /* ====================================================
       SHOPIFY APP ENDPOINT
    ==================================================== */

    const apiUrl =
      "/apps/gold-price?currency=" +
      encodeURIComponent(currency);


    fetch(
      apiUrl,
      {
        method: "GET",

        headers: {
          "Accept": "application/json"
        },

        cache: "no-store"
      }
    )

    .then(function (response) {

      if (!response.ok) {

        throw new Error(
          "Gold price request failed: " +
          response.status
        );

      }

      return response.json();

    })

    .then(function (data) {

      /* VALIDATE */

      if (
        !data ||
        !data.success ||
        !data.prices
      ) {

        throw new Error(
          "Invalid saved gold price response"
        );

      }


      /* API CURRENCY */

      const apiCurrency =
        String(
          data.currency ||
          currency
        )
        .toUpperCase();


      const weightDisplayEl =
        widget.querySelector(
          "[data-weight-display]"
        );

      const purityDisplayEl =
        widget.querySelector(
          "[data-purity-display]"
        );

      const variantMapScript =
        widget.querySelector(
          "[data-variant-gold-map]"
        );


      let variantMap = [];

      if (variantMapScript) {

        try {

          variantMap =
            JSON.parse(
              variantMapScript.textContent || "[]"
            );

        } catch (e) {

          console.warn(
            "Failed to parse variant gold map",
            e
          );

        }

      }


      function renderForVariant(variantData) {

        const activeWeight =
          Number(
            variantData?.weight ?? weight
          ) || 0;

        const activeKarat =
          Number(
            variantData?.karat ?? karat
          ) || 22;

        const activeCraftsmanship =
          Number(
            variantData?.craftsmanship ??
            craftsmanshipPercent
          ) || 0;

        const activeEngravingFee =
          Number(
            variantData?.engravingFee ??
            engravingPercent
          ) || 0;

        const activePackagingFee =
          Number(
            variantData?.packagingFee ??
            packagingPercent
          ) || 0;

        const activeEngravingEnabled =
          variantData?.engravingEnabled !== undefined
            ? Boolean(
                variantData.engravingEnabled
              )
            : engravingEnabled;

        const activePackagingEnabled =
          variantData?.packagingEnabled !== undefined
            ? Boolean(
                variantData.packagingEnabled
              )
            : packagingEnabled;


        if (weightDisplayEl) {

          const formattedWeight =
            Number.isInteger(activeWeight)
              ? activeWeight.toFixed(1)
              : String(activeWeight);

          weightDisplayEl.textContent =
            formattedWeight + " g";

        }


        if (purityDisplayEl) {

          purityDisplayEl.textContent =
            String(activeKarat).toLowerCase() + "k";

        }


        const priceKey =
          String(activeKarat)
            .toLowerCase()
            .replace("k", "") + "k";


        const pricePerGram =
          Number(data.prices[priceKey]) ||
          Number(
            data.prices[
              priceKey.toUpperCase()
            ]
          ) ||
          0;


        if (pricePerGram <= 0) {
          return;
        }


        const goldValue =
          pricePerGram *
          activeWeight;


        let totalFeePercent = 0;


        if (activeCraftsmanship > 0) {

          totalFeePercent +=
            activeCraftsmanship;

        }


        if (
          activeEngravingEnabled &&
          activeEngravingFee > 0
        ) {

          totalFeePercent +=
            activeEngravingFee;

        }


        if (
          activePackagingEnabled &&
          activePackagingFee > 0
        ) {

          totalFeePercent +=
            activePackagingFee;

        }


        const goldPortionPercent =
          100 - totalFeePercent;


        if (goldPortionPercent <= 0) {
          return;
        }


        const finalProductPrice =
          goldValue /
          (goldPortionPercent / 100);


        const craftsmanshipValue =
          finalProductPrice *
          (activeCraftsmanship / 100);


        const engravingValue =
          activeEngravingEnabled
            ? finalProductPrice *
              (activeEngravingFee / 100)
            : 0;


        const packagingValue =
          activePackagingEnabled
            ? finalProductPrice *
              (activePackagingFee / 100)
            : 0;


        const atelierFee =
          craftsmanshipValue +
          engravingValue +
          packagingValue;


        if (priceEl) {

          priceEl.textContent =
            formatPrice(
              pricePerGram,
              apiCurrency
            );

        }


        if (goldValueEl) {

          goldValueEl.textContent =
            formatPrice(
              goldValue,
              apiCurrency
            );

        }


        if (atelierFeeEl) {

          atelierFeeEl.textContent =
            formatPrice(
              atelierFee,
              apiCurrency
            );

        }


        if (finalProductPriceEl) {

          finalProductPriceEl.textContent =
            formatPrice(
              finalProductPrice,
              apiCurrency
            );

        }


        if (footerEl) {

          footerEl.textContent =
            "Latest saved gold price";

        }

      }


      /* INITIAL RENDER */

      const initialVariant =
        variantMap.length
          ? variantMap[0]
          : {
              weight: weight,
              karat: karat,
              craftsmanship:
                craftsmanshipPercent,
              engravingFee:
                engravingPercent,
              packagingFee:
                packagingPercent,
              engravingEnabled:
                engravingEnabled,
              packagingEnabled:
                packagingEnabled
            };


      renderForVariant(
        initialVariant
      );


      /* VARIANT CHANGE */

      function onVariantChange(
        variantId
      ) {

        if (
          !variantId ||
          !variantMap.length
        ) {
          return;
        }


        const found =
          variantMap.find(
            function (v) {

              return (
                String(v.id) ===
                String(variantId)
              );

            }
          );


        if (found) {

          renderForVariant(
            found
          );

        }

      }


      document.addEventListener(
        "variant:change",
        function (e) {

          if (
            e.detail &&
            e.detail.variant &&
            e.detail.variant.id
          ) {

            onVariantChange(
              e.detail.variant.id
            );

          }

        }
      );


      document.addEventListener(
        "change",
        function (e) {

          if (
            e.target &&
            (
              e.target.name === "id" ||
              e.target.closest(
                'form[action*="/cart/add"]'
              )
            )
          ) {

            const form =
              e.target.closest(
                'form[action*="/cart/add"]'
              );


            if (form) {

              const idInput =
                form.querySelector(
                  '[name="id"]'
                );


              if (
                idInput &&
                idInput.value
              ) {

                onVariantChange(
                  idInput.value
                );

              }

            }

          }

        }
      );

    })

    .catch(function (error) {

      console.error(
        "Gold widget error:",
        error
      );


      if (priceEl) {
        priceEl.textContent = "—";
      }


      if (goldValueEl) {
        goldValueEl.textContent = "—";
      }


      if (atelierFeeEl) {
        atelierFeeEl.textContent = "—";
      }


      if (finalProductPriceEl) {
        finalProductPriceEl.textContent = "—";
      }


      if (footerEl) {

        footerEl.textContent =
          "Gold price temporarily unavailable";

      }

    });

  }


  /* ======================================================
     INITIALIZE ALL
  ====================================================== */

  function initAllWidgets() {

    const widgets =
      document.querySelectorAll(
        "[data-gold-widget]"
      );


    widgets.forEach(
      function (widget) {

        initGoldWidget(
          widget
        );

      }
    );

  }


  /* INITIAL LOAD */

  if (
    document.readyState ===
    "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initAllWidgets
    );

  } else {

    initAllWidgets();

  }


  /* SHOPIFY THEME EDITOR */

  document.addEventListener(
    "shopify:section:load",
    function () {

      initAllWidgets();

    }
  );

})();

</script>


{% schema %}
{
  "name": "Live Gold Price",
  "target": "section",
  "settings": []
}
{% endschema %}