{% assign gold_purity = product.metafields.custom.gold_purity.value | default: "22K" %}
{% assign gold_weight = product.metafields.custom.gold_weight.value | default: 0 %}
{% assign craftsmanship = product.metafields.custom.craftsmanship.value | default: 0 %}
{% assign engraving_fee = product.metafields.custom.personal_engraving_fee.value | default: 0 %}
{% assign packaging_fee = product.metafields.custom.premium_packaging_fee.value | default: 0 %}

{% assign engraving_enabled = product.metafields.custom.personal_engraving.value %}
{% assign packaging_enabled = product.metafields.custom.premium_packaging.value %}

{% assign shop_currency = localization.country.currency.iso_code | default: shop.currency %}


