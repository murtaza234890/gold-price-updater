<script>

(function () {


  /*
   * ======================================================
   * GET STOREFRONT CURRENCY
   * ======================================================
   */


  function getActiveCurrency(widget) {

    let currency = "";


    if (
      window.Shopify &&
      window.Shopify.currency
    ) {

      currency =
        window.Shopify.currency.active ||
        window.Shopify.currency.currency ||
        "";

    }


    if (!currency) {

      currency =
        widget.dataset.currency || "";

    }


    return String(currency || "USD")
      .trim()
      .toUpperCase();

  }



  /*
   * ======================================================
   * FORMAT MONEY
   * ======================================================
   */


  function formatPrice(value, currency) {

    const number = Number(value);


    if (!Number.isFinite(number)) {

      return "—";

    }


    try {

      return new Intl.NumberFormat(
        undefined,
        {
          style: "currency",
          currency: currency,

          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(number);

    }


    catch (error) {

      return (
        currency +
        " " +
        number.toLocaleString(
          undefined,
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        )
      );

    }

  }



  /*
   * ======================================================
   * INITIALIZE WIDGET
   * ======================================================
   */


  function initGoldWidget(widget) {


    if (!widget) {

      return;

    }


    /*
     * Prevent duplicate initialization.
     */


    if (
      widget.dataset.initialized === "true"
    ) {

      return;

    }


    widget.dataset.initialized = "true";



    /*
     * ELEMENTS
     */


    const priceEl =
      widget.querySelector(
        "[data-gold-price]"
      );


    const goldValueEl =
      widget.querySelector(
        "[data-gold-value]"
      );


    const atelierFeeEl =
      widget.querySelector(
        "[data-atelier-fee]"
      );


    const finalProductPriceEl =
      widget.querySelector(
        "[data-final-product-price]"
      );


    const updatedEl =
      widget.querySelector(
        "[data-updated-text]"
      );


    const footerEl =
      widget.querySelector(
        "[data-footer-status]"
      );


    const currencyCodeEl =
      widget.querySelector(
        "[data-currency-code]"
      );



    /*
     * PRODUCT DATA
     */


    const karat =
      Number(widget.dataset.karat) || 22;


    const weight =
      Number(widget.dataset.weight) || 0;


    const craftsmanshipPercent =
      Number(widget.dataset.craftsmanship) || 0;


    const engravingPercent =
      Number(widget.dataset.engraving) || 0;


    const packagingPercent =
      Number(widget.dataset.packaging) || 0;


    const engravingEnabled =
      widget.dataset.engravingEnabled === "true";


    const packagingEnabled =
      widget.dataset.packagingEnabled === "true";



    /*
     * STOREFRONT CURRENCY
     */


    const currency =
      getActiveCurrency(widget);


    if (currencyCodeEl) {

      currencyCodeEl.textContent =
        currency;

    }



    /*
     * SHOPIFY APP ENDPOINT
     *
     * This reads the latest saved
     * gold price from your app.
     *
     * It does NOT directly call GoldAPI.
     */


    const apiUrl =
      "/apps/gold-price?currency=" +
      encodeURIComponent(currency);



    /*
     * FETCH GOLD PRICE
     */


    fetch(
      apiUrl,
      {
        method: "GET",

        headers: {
          "Accept": "application/json"
        },

        cache: "no-store"
      }
    )


    .then(function (response) {


      if (!response.ok) {

        throw new Error(
          "Gold price request failed: " +
          response.status
        );

      }


      return response.json();

    })


    .then(function (data) {


      /*
       * Validate response.
       */


      if (
        !data ||
        !data.success ||
        !data.prices
      ) {

        throw new Error(
          "Invalid saved gold price response"
        );

      }



      /*
       * API CURRENCY
       */


      const apiCurrency =
        String(
          data.currency ||
          currency
        )
        .toUpperCase();



      if (currencyCodeEl) {

        currencyCodeEl.textContent =
          apiCurrency;

      }



      /*
       * KARAT PRICE
       *
       * 18K -> 18k
       * 21K -> 21k
       * 22K -> 22k
       * 24K -> 24k
       */


      const priceKey =
        String(karat) + "k";


      const pricePerGram =
        Number(
          data.prices[priceKey]
        );



      if (
        !Number.isFinite(pricePerGram) ||
        pricePerGram <= 0
      ) {

        throw new Error(
          "Gold price unavailable"
        );

      }



      /*
       * ==================================================
       * GOLD VALUE
       *
       * Gold Price / Gram × Gold Weight
       * ==================================================
       */


      const goldValue =
        pricePerGram * weight;



      /*
       * ==================================================
       * ACTIVE FEES
       * ==================================================
       */


      let totalFeePercent = 0;



      /*
       * Craftsmanship
       */


      if (
        craftsmanshipPercent > 0
      ) {

        totalFeePercent +=
          craftsmanshipPercent;

      }



      /*
       * Engraving
       */


      if (
        engravingEnabled &&
        engravingPercent > 0
      ) {

        totalFeePercent +=
          engravingPercent;

      }



      /*
       * Packaging
       */


      if (
        packagingEnabled &&
        packagingPercent > 0
      ) {

        totalFeePercent +=
          packagingPercent;

      }



      /*
       * ==================================================
       * GOLD PORTION
       * ==================================================
       */


      const goldPortionPercent =
        100 - totalFeePercent;



      if (
        goldPortionPercent <= 0
      ) {

        throw new Error(
          "Invalid fee percentages. Total fee percentage must be less than 100%."
        );

      }



      /*
       * ==================================================
       * FINAL PRODUCT PRICE
       *
       * Example:
       *
       * Gold Value = 720
       * Gold portion = 72%
       *
       * Final = 720 / 0.72
       * ==================================================
       */


      const finalProductPrice =
        goldValue /
        (goldPortionPercent / 100);



      /*
       * ==================================================
       * CRAFTSMANSHIP VALUE
       * ==================================================
       */


      const craftsmanshipValue =
        finalProductPrice *
        craftsmanshipPercent /
        100;



      /*
       * ==================================================
       * ENGRAVING VALUE
       * ==================================================
       */


      const engravingValue =
        engravingEnabled
          ? finalProductPrice *
            engravingPercent /
            100
          : 0;



      /*
       * ==================================================
       * PACKAGING VALUE
       * ==================================================
       */


      const packagingValue =
        packagingEnabled
          ? finalProductPrice *
            packagingPercent /
            100
          : 0;



      /*
       * ==================================================
       * ATELIER FEE
       *
       * Craftsmanship
       * + Engraving
       * + Packaging
       * ==================================================
       */


      const atelierFee =
        craftsmanshipValue +
        engravingValue +
        packagingValue;



      /*
       * ==================================================
       * DISPLAY GOLD PRICE
       * ==================================================
       */


      if (priceEl) {

        priceEl.textContent =
          formatPrice(
            pricePerGram,
            apiCurrency
          );

      }



      /*
       * ==================================================
       * DISPLAY GOLD VALUE
       * ==================================================
       */


      if (goldValueEl) {

        goldValueEl.textContent =
          formatPrice(
            goldValue,
            apiCurrency
          );

      }



      /*
       * ==================================================
       * DISPLAY ATELIER FEE
       * ==================================================
       */


      if (atelierFeeEl) {

        atelierFeeEl.textContent =
          formatPrice(
            atelierFee,
            apiCurrency
          );

      }



      /*
       * ==================================================
       * DISPLAY TOTAL PRICE
       * ==================================================
       */


      if (finalProductPriceEl) {

        finalProductPriceEl.textContent =
          formatPrice(
            finalProductPrice,
            apiCurrency
          );

      }



      /*
       * ==================================================
       * LIVE STATUS
       * ==================================================
       */


      if (updatedEl) {

        updatedEl.textContent =
          "LIVE";

      }



      /*
       * ==================================================
       * FOOTER STATUS
       * ==================================================
       */


      if (footerEl) {

        footerEl.textContent =
          "Latest saved gold price";

      }

    })


    /*
     * ======================================================
     * ERROR HANDLING
     * ======================================================
     */


    .catch(function (error) {


      console.error(
        "Gold widget error:",
        error
      );


      if (priceEl) {

        priceEl.textContent =
          "—";

      }


      if (goldValueEl) {

        goldValueEl.textContent =
          "—";

      }


      if (atelierFeeEl) {

        atelierFeeEl.textContent =
          "—";

      }


      if (finalProductPriceEl) {

        finalProductPriceEl.textContent =
          "—";

      }


      if (updatedEl) {

        updatedEl.textContent =
          "Price unavailable";

      }


      if (footerEl) {

        footerEl.textContent =
          "Gold price temporarily unavailable";

      }

    });

  }



  /*
   * ======================================================
   * INITIALIZE ALL WIDGETS
   * ======================================================
   */


  function initAllWidgets() {


    const widgets =
      document.querySelectorAll(
        "[data-gold-widget]"
      );


    widgets.forEach(
      function (widget) {

        initGoldWidget(widget);

      }
    );

  }



  /*
   * ======================================================
   * INITIAL PAGE LOAD
   * ======================================================
   */


  if (
    document.readyState === "loading"
  ) {


    document.addEventListener(
      "DOMContentLoaded",
      initAllWidgets
    );


  } else {


    initAllWidgets();

  }



  /*
   * ======================================================
   * SHOPIFY THEME EDITOR SUPPORT
   * ======================================================
   */


  document.addEventListener(
    "shopify:section:load",
    function () {

      initAllWidgets();

    }
  );


})();

</script>



