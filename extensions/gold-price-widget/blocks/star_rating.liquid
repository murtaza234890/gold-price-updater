{% assign gold_purity = product.metafields.custom.gold_purity.value | default: "22K" %}
{% assign gold_weight = product.metafields.custom.gold_weight.value | default: 0 %}
{% assign craftsmanship = product.metafields.custom.craftsmanship.value | default: 0 %}
{% assign engraving_fee = product.metafields.custom.personal_engraving_fee.value | default: 0 %}
{% assign packaging_fee = product.metafields.custom.premium_packaging_fee.value | default: 0 %}

{% assign engraving_enabled = product.metafields.custom.personal_engraving.value %}
{% assign packaging_enabled = product.metafields.custom.premium_packaging.value %}

{% assign shop_currency = localization.country.currency.iso_code | default: shop.currency %}


<div
  class="gold-price-widget"
  data-gold-widget
  data-karat="{{ gold_purity | remove: 'K' | remove: 'k' }}"
  data-weight="{{ gold_weight }}"
  data-craftsmanship="{{ craftsmanship }}"
  data-engraving="{{ engraving_fee }}"
  data-packaging="{{ packaging_fee }}"
  data-currency="{{ shop_currency }}"
  data-engraving-enabled="{% if engraving_enabled %}true{% else %}false{% endif %}"
  data-packaging-enabled="{% if packaging_enabled %}true{% else %}false{% endif %}"
>


  <!-- =====================================================
       GOLD DETAILS
  ====================================================== -->

  <div class="marami-card marami-gold-card">

    <div class="marami-card-header">

      <div class="marami-heading">
        GOLD DETAILS
      </div>

      <div class="marami-latest-price">

        <span class="marami-gold-dot"></span>

        <span>Latest gold price</span>

        <span
          class="marami-info-icon"
          title="Latest saved gold price"
          aria-label="Latest saved gold price"
        >
          <svg viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 10.5V16"></path>
            <circle
              cx="12"
              cy="7.5"
              r=".6"
              fill="currentColor"
              stroke="none"
            ></circle>
          </svg>
        </span>

      </div>

    </div>


    <!-- GOLD PRICE -->

    <div class="marami-detail-row">

      <div class="marami-detail-left">

        <div class="marami-icon">

          <svg viewBox="0 0 48 48">

            <path d="M12 20h24l5 7H7l5-7Z"></path>

            <path d="M12 20l4-10h16l4 10"></path>

            <path d="M16 10v10"></path>

            <path d="M32 10v10"></path>

          </svg>

        </div>

        <span>Gold Price / g</span>

      </div>

      <strong data-gold-price>—</strong>

    </div>


    <!-- GOLD WEIGHT -->

    <div class="marami-detail-row">

      <div class="marami-detail-left">

        <div class="marami-icon">

          <svg viewBox="0 0 48 48">

            <path d="M18 13h12"></path>

            <path d="M22 13v-4h4v4"></path>

            <path d="M14 18h20l5 22H9l5-22Z"></path>

            <path d="M18 18c0 4 3 6 6 6s6-2 6-6"></path>

          </svg>

        </div>

        <span>Gold Weight</span>

      </div>

      <strong>{{ gold_weight }} g</strong>

    </div>


    <!-- GOLD PURITY -->

    <div class="marami-detail-row">

      <div class="marami-detail-left">

        <div class="marami-icon">

          <svg viewBox="0 0 48 48">

            <path d="M24 7 39 20 24 41 9 20 24 7Z"></path>

            <path d="M9 20h30"></path>

            <path d="m18 20 6 21 6-21"></path>

            <path d="m15 14 9 6 9-6"></path>

          </svg>

        </div>

        <span>Gold Purity</span>

      </div>

      <strong>{{ gold_purity }}</strong>

    </div>


    <!-- GOLD VALUE -->

    <div class="marami-detail-row">

      <div class="marami-detail-left">

        <div class="marami-icon">

          <svg viewBox="0 0 48 48">

            <rect x="11" y="6" width="26" height="36" rx="2"></rect>

            <path d="M16 13h16"></path>

            <circle cx="17" cy="21" r="1"></circle>
            <circle cx="24" cy="21" r="1"></circle>
            <circle cx="31" cy="21" r="1"></circle>

            <circle cx="17" cy="28" r="1"></circle>
            <circle cx="24" cy="28" r="1"></circle>
            <circle cx="31" cy="28" r="1"></circle>

            <circle cx="17" cy="35" r="1"></circle>
            <circle cx="24" cy="35" r="1"></circle>
            <circle cx="31" cy="35" r="1"></circle>

          </svg>

        </div>

        <span>Gold Value</span>

      </div>

      <strong data-gold-value>—</strong>

    </div>

  </div>


  <!-- =====================================================
       MARAMI ATELIER FEE
  ====================================================== -->

  <div class="marami-atelier-card">

    <div class="marami-atelier-icon">

      <svg viewBox="0 0 48 48">

        <path d="M9 34 34 9"></path>

        <path d="M27 8 40 21"></path>

        <path d="M10 39 5 34l10-10 5 5L10 39Z"></path>

        <path d="m31 26 7 7"></path>

        <path d="m35 22 6 6"></path>

        <path d="M14 19 8 13l5-5 6 6"></path>

      </svg>

    </div>


    <div class="marami-atelier-content">

      <div class="marami-section-title">
        MARAMI ATELIER FEE
      </div>

      <div class="marami-atelier-description">
        Includes design development,
        craftsmanship, manufacturing,
        quality finishing and signature packaging.
      </div>

    </div>


    <strong
      class="marami-atelier-price"
      data-atelier-fee
    >
      —
    </strong>

  </div>


  <!-- =====================================================
       TOTAL PRICE
  ====================================================== -->

  <div class="marami-total-card">

    <div class="marami-total-label">
      TOTAL PRICE
    </div>


    <div class="marami-total-divider"></div>


    <strong
      class="marami-total-price"
      data-final-product-price
    >
      —
    </strong>

  </div>


  <!-- =====================================================
       FOOTER
  ====================================================== -->

  <div class="marami-widget-footer">

    <span class="marami-footer-dot"></span>

    <span data-footer-status>
      Latest saved gold price
    </span>

  </div>

</div>



<style>

/* =========================================================
   MAIN WIDGET
========================================================= */

.gold-price-widget {

  width: 100%;
  max-width: 560px;

  margin: 20px 0;

  box-sizing: border-box;

  color: #302a24;

}


/* =========================================================
   GOLD DETAILS CARD
========================================================= */

.marami-card {

  width: 100%;

  box-sizing: border-box;

  background: #fbf8f2;

  border: 1px solid #eee6da;

  border-radius: 10px;

  overflow: hidden;

  box-shadow:
    0 2px 8px rgba(70, 52, 30, 0.04);

}


.marami-gold-card {

  padding: 21px 25px 6px;

}


/* =========================================================
   HEADER
========================================================= */

.marami-card-header {

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  margin-bottom: 8px;

}


.marami-heading {

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 18px;

  line-height: 1;

  letter-spacing: 3px;

  font-weight: 500;

  color: #29251f;

}


.marami-latest-price {

  display: flex;

  align-items: center;

  gap: 6px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 11px;

  color: #9b8d78;

  white-space: nowrap;

}


.marami-gold-dot {

  width: 8px;

  height: 8px;

  border-radius: 50%;

  background: #b59664;

  flex-shrink: 0;

}


/* =========================================================
   INFO ICON
========================================================= */

.marami-info-icon {

  width: 17px;
  height: 17px;

  display: inline-flex;

  align-items: center;
  justify-content: center;

  color: #a69272;

}


.marami-info-icon svg {

  width: 15px;
  height: 15px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.5;

}


/* =========================================================
   DETAIL ROW
========================================================= */

.marami-detail-row {

  min-height: 53px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 20px;

  border-bottom: 1px solid #eee7dc;

}


.marami-detail-left {

  display: flex;

  align-items: center;

  gap: 17px;

  min-width: 0;

}


.marami-detail-left > span {

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 14px;

  color: #595149;

  white-space: nowrap;

}


.marami-detail-row strong {

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 16px;

  font-weight: 500;

  color: #28231e;

  text-align: right;

  white-space: nowrap;

}


/* =========================================================
   GOLD ICONS
========================================================= */

.marami-icon {

  width: 30px;
  height: 30px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  color: #b79a70;

}


.marami-icon svg {

  width: 28px;
  height: 28px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.25;

  stroke-linecap: round;

  stroke-linejoin: round;

}


/* =========================================================
   ATELIER FEE
========================================================= */

.marami-atelier-card {

  display: flex;

  align-items: center;

  gap: 16px;

  width: 100%;

  box-sizing: border-box;

  margin-top: 7px;

  padding: 18px 25px;

  background: #f3e9de;

  border: 1px solid #eee2d5;

  border-radius: 10px;

  box-shadow:
    0 2px 8px rgba(70, 52, 30, 0.035);

}


.marami-atelier-icon {

  width: 34px;
  height: 34px;

  display: flex;

  align-items: center;
  justify-content: center;

  flex-shrink: 0;

  color: #a68a61;

}


.marami-atelier-icon svg {

  width: 31px;
  height: 31px;

  fill: none;

  stroke: currentColor;

  stroke-width: 1.25;

  stroke-linecap: round;

  stroke-linejoin: round;

}


.marami-atelier-content {

  min-width: 0;

  flex: 1;

}


.marami-section-title {

  margin-bottom: 7px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 16px;

  letter-spacing: 2.7px;

  font-weight: 500;

  color: #302a24;

}


.marami-atelier-description {

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 10.5px;

  line-height: 1.45;

  color: #6f655c;

}


.marami-atelier-price {

  flex-shrink: 0;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 16px;

  font-weight: 500;

  color: #302a24;

  white-space: nowrap;

  text-align: right;

}


/* =========================================================
   TOTAL PRICE CARD
   IMPORTANT: GRID LAYOUT
========================================================= */

.marami-total-card {

  width: 100%;

  min-height: 76px;

  box-sizing: border-box;

  margin-top: 7px;

  padding: 0 25px;

  display: grid;

  grid-template-columns: 1fr auto 1fr;

  align-items: center;

  column-gap: 25px;

  background: #e9d8c4;

  border-radius: 10px;

  box-shadow:
    0 2px 8px rgba(70, 52, 30, 0.035);

}


/* LEFT SIDE */

.marami-total-label {

  justify-self: start;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 17px;

  line-height: 1.1;

  letter-spacing: 2.5px;

  font-weight: 500;

  color: #302a24;

  white-space: nowrap;

}


/* CENTER DIVIDER */

.marami-total-divider {

  width: 1px;

  height: 38px;

  background: rgba(115, 91, 62, 0.30);

  justify-self: center;

}


/* RIGHT SIDE */

.marami-total-price {

  justify-self: end;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 28px;

  line-height: 1;

  font-weight: 400;

  color: #29231d;

  white-space: nowrap;

  text-align: right;

}


/* =========================================================
   FOOTER
========================================================= */

.marami-widget-footer {

  display: flex;

  align-items: center;

  gap: 7px;

  margin-top: 11px;

  padding-left: 3px;

  font-family:
    Georgia,
    "Times New Roman",
    serif;

  font-size: 10px;

  color: #9b9288;

}


.marami-footer-dot {

  width: 5px;
  height: 5px;

  border-radius: 50%;

  background: #6e9b69;

  flex-shrink: 0;

}


/* =========================================================
   TABLET / MOBILE
========================================================= */

@media screen and (max-width: 749px) {

  .gold-price-widget {

    max-width: 100%;

    margin: 15px 0;

  }


  .marami-gold-card {

    padding: 18px 18px 5px;

  }


  .marami-card-header {

    gap: 10px;

  }


  .marami-heading {

    font-size: 15px;

    letter-spacing: 2.3px;

  }


  .marami-latest-price {

    font-size: 9px;

    gap: 4px;

  }


  .marami-gold-dot {

    width: 6px;
    height: 6px;

  }


  .marami-detail-row {

    min-height: 49px;

    gap: 10px;

  }


  .marami-detail-left {

    gap: 12px;

  }


  .marami-icon {

    width: 25px;
    height: 25px;

  }


  .marami-icon svg {

    width: 24px;
    height: 24px;

  }


  .marami-detail-left > span {

    font-size: 12px;

  }


  .marami-detail-row strong {

    font-size: 13px;

  }


  /* ATELIER */

  .marami-atelier-card {

    gap: 10px;

    padding: 16px 18px;

  }


  .marami-atelier-icon {

    width: 28px;
    height: 28px;

  }


  .marami-atelier-icon svg {

    width: 27px;
    height: 27px;

  }


  .marami-section-title {

    font-size: 13px;

    letter-spacing: 2px;

  }


  .marami-atelier-description {

    font-size: 8.5px;

  }


  .marami-atelier-price {

    font-size: 13px;

  }


  /* =====================================================
     MOBILE TOTAL PRICE
  ===================================================== */

  .marami-total-card {

    min-height: 66px;

    padding: 0 18px;

    grid-template-columns: 1fr auto 1fr;

    column-gap: 14px;

  }


  .marami-total-label {

    font-size: 12px;

    letter-spacing: 1.7px;

  }


  .marami-total-divider {

    height: 32px;

  }


  .marami-total-price {

    font-size: 20px;

  }


  .marami-widget-footer {

    font-size: 9px;

  }

}


/* =========================================================
   VERY SMALL MOBILE
========================================================= */

@media screen and (max-width: 420px) {

  .marami-latest-price span:nth-child(2) {

    display: none;

  }


  .marami-total-card {

    padding: 0 14px;

    column-gap: 10px;

  }


  .marami-total-label {

    font-size: 10px;

    letter-spacing: 1.3px;

  }


  .marami-total-divider {

    height: 28px;

  }


  .marami-total-price {

    font-size: 17px;

  }


  .marami-atelier-card {

    padding-left: 14px;

    padding-right: 14px;

  }


  .marami-atelier-price {

    font-size: 12px;

  }

}

</style>



<script>

(function () {


  /* ======================================================
     GET ACTIVE CURRENCY
  ====================================================== */

  function getActiveCurrency(widget) {

    let currency = "";


    if (
      window.Shopify &&
      window.Shopify.currency
    ) {

      currency =
        window.Shopify.currency.active ||
        window.Shopify.currency.currency ||
        "";

    }


    if (!currency) {

      currency =
        widget.dataset.currency || "";

    }


    return String(currency || "USD")
      .trim()
      .toUpperCase();

  }



  /* ======================================================
     FORMAT MONEY
  ====================================================== */

  function formatPrice(value, currency) {

    const number = Number(value);


    if (!Number.isFinite(number)) {

      return "—";

    }


    try {

      return new Intl.NumberFormat(
        undefined,
        {
          style: "currency",
          currency: currency,

          minimumFractionDigits: 2,
          maximumFractionDigits: 2
        }
      ).format(number);

    }

    catch (error) {

      return (
        currency +
        " " +
        number.toLocaleString(
          undefined,
          {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
          }
        )
      );

    }

  }



  /* ======================================================
     INITIALIZE
  ====================================================== */

  function initGoldWidget(widget) {


    if (!widget) {

      return;

    }


    if (
      widget.dataset.initialized === "true"
    ) {

      return;

    }


    widget.dataset.initialized = "true";


    /* ELEMENTS */

    const priceEl =
      widget.querySelector(
        "[data-gold-price]"
      );


    const goldValueEl =
      widget.querySelector(
        "[data-gold-value]"
      );


    const atelierFeeEl =
      widget.querySelector(
        "[data-atelier-fee]"
      );


    const finalProductPriceEl =
      widget.querySelector(
        "[data-final-product-price]"
      );


    const footerEl =
      widget.querySelector(
        "[data-footer-status]"
      );


    /* PRODUCT DATA */

    const karat =
      Number(widget.dataset.karat) || 22;


    const weight =
      Number(widget.dataset.weight) || 0;


    const craftsmanshipPercent =
      Number(widget.dataset.craftsmanship) || 0;


    const engravingPercent =
      Number(widget.dataset.engraving) || 0;


    const packagingPercent =
      Number(widget.dataset.packaging) || 0;


    const engravingEnabled =
      widget.dataset.engravingEnabled === "true";


    const packagingEnabled =
      widget.dataset.packagingEnabled === "true";


    /* CURRENCY */

    const currency =
      getActiveCurrency(widget);



    /* ====================================================
       SHOPIFY APP ENDPOINT
    ==================================================== */

    const apiUrl =
      "/apps/gold-price?currency=" +
      encodeURIComponent(currency);



    fetch(
      apiUrl,
      {
        method: "GET",

        headers: {
          "Accept": "application/json"
        },

        cache: "no-store"
      }
    )


    .then(function (response) {

      if (!response.ok) {

        throw new Error(
          "Gold price request failed: " +
          response.status
        );

      }

      return response.json();

    })


    .then(function (data) {


      /* VALIDATE */

      if (
        !data ||
        !data.success ||
        !data.prices
      ) {

        throw new Error(
          "Invalid saved gold price response"
        );

      }



      /* API CURRENCY */

      const apiCurrency =
        String(
          data.currency ||
          currency
        )
        .toUpperCase();



      /* PRICE KEY */

      const priceKey =
        String(karat) + "k";


      const pricePerGram =
        Number(
          data.prices[priceKey]
        );



      if (
        !Number.isFinite(pricePerGram) ||
        pricePerGram <= 0
      ) {

        throw new Error(
          "Gold price unavailable"
        );

      }



      /* ==================================================
         GOLD VALUE
      ================================================== */

      const goldValue =
        pricePerGram * weight;



      /* ==================================================
         FEES
      ================================================== */

      let totalFeePercent = 0;


      if (
        craftsmanshipPercent > 0
      ) {

        totalFeePercent +=
          craftsmanshipPercent;

      }


      if (
        engravingEnabled &&
        engravingPercent > 0
      ) {

        totalFeePercent +=
          engravingPercent;

      }


      if (
        packagingEnabled &&
        packagingPercent > 0
      ) {

        totalFeePercent +=
          packagingPercent;

      }



      /* ==================================================
         GOLD PORTION
      ================================================== */

      const goldPortionPercent =
        100 - totalFeePercent;


      if (
        goldPortionPercent <= 0
      ) {

        throw new Error(
          "Invalid fee percentages."
        );

      }



      /* ==================================================
         FINAL PRICE
      ================================================== */

      const finalProductPrice =
        goldValue /
        (goldPortionPercent / 100);



      /* ==================================================
         CRAFTSMANSHIP
      ================================================== */

      const craftsmanshipValue =
        finalProductPrice *
        craftsmanshipPercent /
        100;



      /* ==================================================
         ENGRAVING
      ================================================== */

      const engravingValue =
        engravingEnabled
          ? finalProductPrice *
            engravingPercent /
            100
          : 0;



      /* ==================================================
         PACKAGING
      ================================================== */

      const packagingValue =
        packagingEnabled
          ? finalProductPrice *
            packagingPercent /
            100
          : 0;



      /* ==================================================
         ATELIER FEE
      ================================================== */

      const atelierFee =
        craftsmanshipValue +
        engravingValue +
        packagingValue;



      /* ==================================================
         DISPLAY GOLD PRICE
      ================================================== */

      if (priceEl) {

        priceEl.textContent =
          formatPrice(
            pricePerGram,
            apiCurrency
          );

      }



      /* ==================================================
         DISPLAY GOLD VALUE
      ================================================== */

      if (goldValueEl) {

        goldValueEl.textContent =
          formatPrice(
            goldValue,
            apiCurrency
          );

      }



      /* ==================================================
         DISPLAY ATELIER FEE
      ================================================== */

      if (atelierFeeEl) {

        atelierFeeEl.textContent =
          formatPrice(
            atelierFee,
            apiCurrency
          );

      }



      /* ==================================================
         DISPLAY TOTAL
      ================================================== */

      if (finalProductPriceEl) {

        finalProductPriceEl.textContent =
          formatPrice(
            finalProductPrice,
            apiCurrency
          );

      }



      /* ==================================================
         FOOTER
      ================================================== */

      if (footerEl) {

        footerEl.textContent =
          "Latest saved gold price";

      }

    })


    /* ====================================================
       ERROR
    ==================================================== */

    .catch(function (error) {

      console.error(
        "Gold widget error:",
        error
      );


      if (priceEl) {

        priceEl.textContent = "—";

      }


      if (goldValueEl) {

        goldValueEl.textContent = "—";

      }


      if (atelierFeeEl) {

        atelierFeeEl.textContent = "—";

      }


      if (finalProductPriceEl) {

        finalProductPriceEl.textContent = "—";

      }


      if (footerEl) {

        footerEl.textContent =
          "Gold price temporarily unavailable";

      }

    });

  }



  /* ======================================================
     INITIALIZE ALL
  ====================================================== */

  function initAllWidgets() {

    const widgets =
      document.querySelectorAll(
        "[data-gold-widget]"
      );


    widgets.forEach(
      function (widget) {

        initGoldWidget(widget);

      }
    );

  }



  /* INITIAL LOAD */

  if (
    document.readyState === "loading"
  ) {

    document.addEventListener(
      "DOMContentLoaded",
      initAllWidgets
    );

  }

  else {

    initAllWidgets();

  }



  /* SHOPIFY THEME EDITOR */

  document.addEventListener(
    "shopify:section:load",
    function () {

      initAllWidgets();

    }
  );


})();

</script>



